# Local Chrome executable, if it is not found automatically.
# PLANTS_CHROME=/path/to/chrome

# Vercel: connect a public Blob store to the project (Preview + Production).
# The integration supplies BLOB_READ_WRITE_TOKEN. Never commit a real token.
# BLOB_READ_WRITE_TOKEN=

# Local development defaults to tmp/shared-trees. No Blob account is needed.
# PLANTS_SHARE_DIR=/absolute/path/to/local/shared-trees

# Optional canonical origin for cards (otherwise uses the request host).
# PLANTS_PUBLIC_ORIGIN=https://sitebonsai.vercel.app
