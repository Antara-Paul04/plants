{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/grow.js": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png"
    }
  ]
}
