{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/grow.js": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/tree.js": {
      "includeFiles": "app/public/{index,card-preview,404}.html",
      "maxDuration": 15
    },
    "api/share.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/t/:id/image.png",
      "destination": "/api/tree?id=:id&image=1"
    },
    {
      "source": "/t/:id",
      "destination": "/api/tree?id=:id"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png"
    }
  ]
}
