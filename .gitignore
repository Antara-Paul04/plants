# No framework or toolchain has been chosen yet (see docs/STATUS.md).
# This file covers only what is generic. Stack-specific entries get added when a
# stack is actually chosen — please do not pre-emptively add them.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies and build output
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# Local scratch
# Use tmp/ for anything throwaway that should not be committed.
tmp/
*.local

# Reference material
# references/ is tracked on purpose — screenshots and visual tests are project
# context, not build artefacts. If a large binary asset ever needs excluding,
# exclude that file specifically rather than the directory.

# Site survey captures — 63MB of 2x full-page PNGs. The analysis (INDEX.md,
# results.json, sites.txt) is committed; the images stay local for review.
references/experiments/site-survey-*/*.png
references/experiments/site-survey-*/_failed/
# Website-beside-tree pairs and the raw site shots that compose them (capture.mjs
# --with-site). Another 52MB on top of the trees. The pairs are review material,
# regenerable from results.json plus a re-shoot; the analysis stays committed.
references/experiments/site-survey-*/pairs/
references/experiments/site-survey-*/_site/
# Reliability sweep — 122MB of trees, site shots and pairs across 79 sites. The
# analysis (INDEX.md, analysis.txt, results.json) is committed; the images stay
# local, and are regenerable from results.json plus a re-shoot.
references/experiments/reliability-sweep-*/pairs/
references/experiments/reliability-sweep-*/_site/
references/experiments/reliability-sweep-*/*.png
references/experiments/site-survey-AFTER-*/pairs/
references/experiments/site-survey-AFTER-*/_site/
references/experiments/site-survey-AFTER-*/*.png

# Re-check captures — the report and results.json are committed, images stay local.
references/experiments/retest-*/pairs/
references/experiments/retest-*/_site/
references/experiments/retest-*/_failed/
references/experiments/retest-*/**/*.png
references/experiments/retest-*/*.png

# Deployment build output and dependencies
public/
node_modules/
.vercel/
